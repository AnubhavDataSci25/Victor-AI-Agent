<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VICTOR // COMPANION V1"
            android:textColor="@color/accent_cyan"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Controlled Remote Agent • PC is the Sole Interface"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/bg_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTION STATUS"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="NOT CONNECTED"
                android:textColor="@color/accent_rose"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Setup Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/bg_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VICTOR PC SERVER IP"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etServerIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="192.168.1.10"
                android:textColor="@color/text_primary"
                android:textColorHint="#465870"
                android:inputType="textUri" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="PORT"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etServerPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="8000"
                android:text="8000"
                android:textColor="@color/text_primary"
                android:textColorHint="#465870"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="PAIRING 6-DIGIT PIN"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etPairingPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="123456"
                android:textColor="@color/text_primary"
                android:textColorHint="#465870"
                android:inputType="number" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent_cyan"
                android:text="PAIR &amp; CONNECT"
                android:textColor="@color/bg_primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUnpair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/accent_rose"
                android:text="DISCONNECT / UNPAIR"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Permissions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/bg_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM PERMISSIONS"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRequestPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="GRANT RUNTIME PERMISSIONS"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnNotificationAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ENABLE NOTIFICATION LISTENER"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
